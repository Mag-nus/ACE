<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <Optimize>true</Optimize>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <NoWarn>CS0618;CS8632;CS0169;MSB3246;MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(AceBin)/*.dll" Exclude="$(AceBin)/ACE.Server.exe" Private="true" />
  </ItemGroup>
  <PropertyGroup>
    <AceBin Condition="'$(AceBin)' == ''">$(MSBuildThisFileDirectory)../../../../Source/ACE.Server/bin/x64/Release/net10.0</AceBin>
  </PropertyGroup>
</Project>
