<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <Optimize>true</Optimize>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <NoWarn>CS0618;CS8632</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <AceBin Condition="'$(AceBin)' == ''">$(MSBuildThisFileDirectory)../../../Source/ACE.Server/bin/x64/Release/net10.0</AceBin>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="ACE.Server"><HintPath>$(AceBin)/ACE.Server.dll</HintPath></Reference>
    <Reference Include="ACE.DatLoader"><HintPath>$(AceBin)/ACE.DatLoader.dll</HintPath></Reference>
    <Reference Include="ACE.Entity"><HintPath>$(AceBin)/ACE.Entity.dll</HintPath></Reference>
    <Reference Include="ACE.Common"><HintPath>$(AceBin)/ACE.Common.dll</HintPath></Reference>
    <Reference Include="log4net"><HintPath>$(AceBin)/log4net.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(AceBin)/0Harmony.dll</HintPath></Reference>
  </ItemGroup>
</Project>
