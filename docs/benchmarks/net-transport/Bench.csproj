<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>disable</Nullable>
    <Configuration>Release</Configuration>
    <Optimize>true</Optimize>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <NoWarn>CS0618;CS8981;CS0162;CS0219</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <PropertyGroup>
    <AceBin Condition="'$(AceBin)' == ''">$(MSBuildThisFileDirectory)../../../Source/ACE.Server/bin/x64/Release/net10.0</AceBin>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ACE.Server"><HintPath>$(AceBin)/ACE.Server.dll</HintPath></Reference>
    <Reference Include="ACE.Common"><HintPath>$(AceBin)/ACE.Common.dll</HintPath></Reference>
    <Reference Include="ACE.Entity"><HintPath>$(AceBin)/ACE.Entity.dll</HintPath></Reference>
    <Reference Include="ACE.DatLoader"><HintPath>$(AceBin)/ACE.DatLoader.dll</HintPath></Reference>
    <Reference Include="ACE.Database"><HintPath>$(AceBin)/ACE.Database.dll</HintPath></Reference>
    <Reference Include="log4net"><HintPath>$(AceBin)/log4net.dll</HintPath></Reference>
  </ItemGroup>

</Project>
